{#- Mobile menu (native modal dialog) on the homepage and the team page -#}
{%- set offen = praxis.oeffnungszeiten | geoeffnet %}
  <!-- ============ Mobile menu ============ -->
  <dialog id="menu" class="menu-dialog" aria-label="Menü">
    <div class="flex min-h-full flex-col px-5 pb-[max(2rem,env(safe-area-inset-bottom))] sm:px-8">
      <div class="flex h-[4.25rem] items-center justify-between gap-4 lg:h-20">
        <span class="flex items-center gap-3 text-ink">
          <svg class="size-9 shrink-0" aria-hidden="true"><use href="#mark"/></svg>
          <span class="leading-none">
            <span class="block text-[0.6875rem] font-semibold tracking-[0.22em] text-body uppercase">{{ praxis.name | erstesWort }}</span>
            <span class="font-display mt-1 block text-[1.5rem] font-[470] tracking-[-0.01em]">{{ praxis.name | restWorte }}</span>
          </span>
        </span>
        <button type="button" id="menu-close" class="inline-flex min-h-12 items-center gap-2 rounded-full border border-line px-4 font-semibold text-ink hover:border-ink">
          <svg class="size-5" aria-hidden="true"><use href="#i-close"/></svg>
          Schließen
        </button>
      </div>
      <nav aria-label="Menü" class="mt-6">
        <ul class="border-t border-line">
          {%- for link in hauptmenue %}
          <li><a href="{{ link.href }}" class="flex min-h-16 items-center justify-between gap-4 border-b border-line py-3 {{ 'text-brand' if link.aktiv else 'text-ink' }}"{% if link.aktiv %} aria-current="page"{% endif %}><span class="font-display text-[1.75rem] leading-tight font-[420]">{{ link.text_menue or link.text }}</span>{% if link.aktiv %}<span class="label !text-brand">Sie sind hier</span>{% else %}<svg class="size-5 text-brand" aria-hidden="true"><use href="#i-arrow"/></svg>{% endif %}</a></li>
          {%- endfor %}
        </ul>
      </nav>
      <div class="mt-auto pt-10">
        <p class="text-[1rem] text-body">{% if offen.length %}{% for z in offen %}{{ z.tage }} {{ z.zeiten }}{% if not loop.last %} · {% endif %}{% endfor %}{% if praxis.termin_hinweis %}<br>{{ praxis.termin_hinweis }}{% endif %}{% else %}{{ praxis.ohne_oeffnungszeiten }}{% endif %}</p>
        <a href="tel:{{ praxis.telefon_link }}" class="btn btn-primary mt-4 w-full">
          <svg class="size-5" aria-hidden="true"><use href="#i-phone"/></svg>
          {{ praxis.telefon | nbsp }} anrufen
        </a>
        <p class="mt-4 text-[1rem] text-body">{{ praxis.strasse }} · {{ praxis.plz }} {{ praxis.ort }}</p>
      </div>
    </div>
  </dialog>
