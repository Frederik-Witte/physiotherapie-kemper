{#- Base layout for all pages. `seite` (front matter): "start", "impressum" or "datenschutz". -#}
{%- set start = (seite == "start") -%}
{%- if start -%}
  {%- set seoTitel = startseite.seo.titel -%}
  {%- set seoBeschreibung = startseite.seo.beschreibung -%}
  {%- set teilenTitel = startseite.seo.teilen_titel or startseite.seo.titel -%}
  {%- set teilenBeschreibung = startseite.seo.teilen_beschreibung or startseite.seo.beschreibung -%}
{%- else -%}
  {%- set seoTitel = rechtliches[seite].seo_titel -%}
  {%- set seoBeschreibung = rechtliches[seite].seo_beschreibung -%}
  {%- set teilenTitel = seoTitel -%}
  {%- set teilenBeschreibung = seoBeschreibung -%}
{%- endif -%}
<!doctype html>
<html lang="de" class="no-js">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
  <title>{{ seoTitel | klartext(praxis) }}</title>
  <meta name="description" content="{{ seoBeschreibung | klartext(praxis) }}">
  <meta name="robots" content="{{ site.robots }}">
  <meta name="theme-color" content="#f7f3ec">
  <meta name="format-detection" content="telephone=no">

  <meta property="og:type" content="website">
  <meta property="og:locale" content="de_DE">
  <meta property="og:site_name" content="{{ praxis.name }}">
  <meta property="og:url" content="{{ site.url }}{{ page.url | replace('/', '', 1) }}">
  <meta property="og:title" content="{{ teilenTitel | klartext(praxis) }}">
  <meta property="og:description" content="{{ teilenBeschreibung | klartext(praxis) }}">
  {% ogBild startseite.seo.teilen_bild, startseite.seo.teilen_bild_alt, site.url %}
  <meta name="twitter:card" content="summary_large_image">

  <link rel="icon" type="image/svg+xml" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 40 40'%3E%3Crect width='40' height='40' rx='10' fill='%230d1c4b'/%3E%3Cg transform='translate(3 3) scale(.85)'%3E%3Cpath d='M3.5 26.8C8.5 31.8 27.5 32 36.5 20.8' fill='none' stroke='%239cc8ef' stroke-width='2' stroke-linecap='round'/%3E%3Ccircle cx='21.4' cy='6.6' r='3.9' fill='%239cc8ef'/%3E%3Cpath d='M8 13C12.2 19 16.2 25.8 19.4 35.5 22.6 25.6 27.6 17.4 33.2 9.2 28.8 15.2 24.6 18.8 20.2 19.6 15.8 19.6 12 17.2 8 13Z' fill='%23f7f3ec'/%3E%3C/g%3E%3C/svg%3E">

  <link rel="preload" href="/assets/fonts/fraunces/fraunces-latin-opsz-normal.woff2" as="font" type="font/woff2" crossorigin>
  <link rel="preload" href="/assets/fonts/figtree/figtree-latin-wght-normal.woff2" as="font" type="font/woff2" crossorigin>
  <link rel="stylesheet" href="/styles.css">
  <script>document.documentElement.classList.replace('no-js', 'js');</script>
</head>
<body>
  {% include "partials/sprite.njk" %}

  <a href="#main" class="sr-only z-50 rounded-full bg-navy-900 px-5 py-3 font-semibold text-paper focus:not-sr-only focus:fixed focus:top-3 focus:left-3">Zum Inhalt springen</a>

  {% include "partials/banner.njk" %}
  {% include "partials/header.njk" %}
  {%- if start %}
  {% include "partials/menu.njk" %}
  {%- endif %}

  {{ content | safe }}

  {% include "partials/footer.njk" %}
  {% include "partials/callbar.njk" %}
  {%- if start %}

{% include "partials/script.njk" %}
  {%- endif %}
</body>
</html>
