{#- Die Praxis – photo gallery (galerie.yml). Layout repeats every 5 photos: wide+narrow, narrow+wide, full width. -#}
{%- set muster = [
  { figur: "col-span-2 lg:col-span-7", foto: "aspect-[4/3] rounded-[1.5rem] lg:aspect-auto lg:h-[34rem] lg:rounded-[2rem]", sizes: "(min-width: 1024px) 58vw, 100vw", schmal: false },
  { figur: "col-span-1 lg:col-span-5", foto: "aspect-[3/4] rounded-[1.25rem] lg:aspect-auto lg:h-[34rem] lg:rounded-[2rem]", sizes: "(min-width: 1024px) 50vw, 70vw", schmal: true },
  { figur: "col-span-1 lg:col-span-5", foto: "aspect-[3/4] rounded-[1.25rem] lg:aspect-auto lg:h-[30rem] lg:rounded-[2rem]", sizes: "(min-width: 1024px) 50vw, 70vw", schmal: true },
  { figur: "col-span-2 lg:col-span-7", foto: "aspect-[4/3] rounded-[1.5rem] lg:aspect-auto lg:h-[30rem] lg:rounded-[2rem]", sizes: "(min-width: 1024px) 58vw, 100vw", schmal: false },
  { figur: "col-span-2 lg:col-span-12", foto: "aspect-[4/3] rounded-[1.5rem] sm:aspect-[16/9] lg:aspect-[21/9] lg:rounded-[2rem]", sizes: "(min-width: 1344px) 1248px, 100vw", schmal: false }
] -%}
{%- set bilder = galerie.bilder | mitBild -%}
{%- if bilder.length %}

    <!-- ============ Die Praxis ============ -->
    <section id="praxis" class="py-16 sm:py-24 lg:py-28" aria-labelledby="praxis-title">
      <div class="mx-auto max-w-[84rem] px-5 sm:px-8 lg:px-12">
        <div class="grid gap-6 lg:grid-cols-12 lg:items-end lg:gap-12">
          <div class="lg:col-span-6">
            <p class="eyebrow">{{ galerie.eyebrow }}</p>
            <h2 id="praxis-title" class="font-display mt-5 text-[2.2rem] leading-[1.08] font-[420] tracking-[-0.018em] sm:mt-6 sm:text-[2.9rem] xl:text-[3.3rem]">{{ galerie.titel }}</h2>
          </div>
          {%- if galerie.text %}
          <div class="lg:col-span-5 lg:col-start-8">
            <p class="max-w-[30rem]">{{ galerie.text | platzhalter(praxis) | safe }}</p>
          </div>
          {%- endif %}
        </div>

        <div class="mt-10 grid grid-cols-2 gap-x-3 gap-y-7 sm:gap-x-5 lg:mt-16 lg:grid-cols-12 lg:gap-x-6 lg:gap-y-12">
          {%- for b in bilder %}
          {%- set pos = loop.index0 % 5 %}
          {#- A wide or narrow photo that would end up alone in its row spans the full width instead -#}
          {%- set m = muster[4] if (loop.last and (pos == 0 or pos == 2)) else muster[pos] %}
          <figure class="{{ m.figur }}" data-reveal>
            <div class="photo photo-zoom {{ m.foto }}">
              <img src="{{ b.bild }}" sizes="{{ m.sizes }}" loading="lazy" decoding="async"{% if b.bildausschnitt %} class="{{ b.bildausschnitt }}"{% endif %} alt="{{ b.alt }}">
            </div>
            {%- if b.titel or b.beschriftung %}
            {%- if m.schmal %}
            <figcaption class="mt-3 text-[1rem] leading-snug text-muted">{% if b.titel %}<span class="font-semibold text-ink">{{ b.titel }}</span>{% endif %}{% if b.titel and b.beschriftung %}<span class="max-sm:hidden"> · </span><br class="sm:hidden">{% endif %}{{ b.beschriftung }}</figcaption>
            {%- else %}
            <figcaption class="mt-3 text-[1rem] text-muted">{% if b.titel %}<span class="font-semibold text-ink">{{ b.titel }}</span>{% endif %}{% if b.titel and b.beschriftung %} · {% endif %}{{ b.beschriftung }}</figcaption>
            {%- endif %}
            {%- endif %}
          </figure>
          {%- endfor %}
        </div>
      </div>
    </section>
{%- endif %}
