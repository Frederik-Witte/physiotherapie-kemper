{#- Kontakt & Anfahrt (startseite.yml → kontakt; all contact data from praxis.yml) -#}
{%- set k = startseite.kontakt -%}
{%- set gb = praxis.google_bewertung -%}
{%- set zeiten = praxis.oeffnungszeiten | oeffnungszeiten %}

    <!-- ============ Kontakt ============ -->
    <section id="kontakt" class="bg-stone py-16 sm:py-24 lg:py-28" aria-labelledby="kontakt-title">
      <div class="mx-auto max-w-[84rem] px-5 sm:px-8 lg:px-12">
        <div class="grid gap-6 lg:grid-cols-12 lg:items-end lg:gap-12">
          <div class="lg:col-span-7">
            <p class="eyebrow">{{ k.eyebrow }}</p>
            <h2 id="kontakt-title" class="font-display mt-5 text-[2.2rem] leading-[1.08] font-[420] tracking-[-0.018em] sm:mt-6 sm:text-[2.9rem] xl:text-[3.3rem]">{{ k.titel }}</h2>
          </div>
          {%- if k.text %}
          <div class="lg:col-span-5">
            <p class="max-w-[30rem]">{{ k.text | platzhalter(praxis) | safe }}</p>
          </div>
          {%- endif %}
        </div>

        <div class="mt-10 overflow-hidden rounded-[1.75rem] bg-navy-900 text-paper lg:mt-14 lg:rounded-[2.25rem]">
          <div class="grid lg:grid-cols-12">
            <div class="p-6 sm:p-10 lg:col-span-7 lg:p-14">
              <p class="label !text-brand-light">Telefon</p>
              <a href="tel:{{ praxis.telefon_link }}" class="font-display mt-2 block py-1 text-[2.6rem] leading-none font-[400] tracking-[-0.02em] whitespace-nowrap text-paper hover:text-brand-light sm:text-[4rem] xl:text-[5.25rem]">{{ praxis.telefon | nbsp }}</a>
              <div class="mt-8 flex flex-col gap-3 sm:flex-row">
                <a href="tel:{{ praxis.telefon_link }}" class="btn btn-light">
                  <svg class="size-5" aria-hidden="true"><use href="#i-phone"/></svg>
                  {{ k.button_anrufen }}
                </a>
                {%- if praxis.routenlink %}
                <a href="{{ praxis.routenlink }}" target="_blank" rel="noopener" class="btn btn-outline-light">
                  <svg class="size-5" aria-hidden="true"><use href="#i-pin"/></svg>
                  {{ k.button_route }}
                  <svg class="size-4 opacity-70" aria-hidden="true"><use href="#i-arrow-up-right"/></svg>
                  <span class="sr-only">(öffnet Google Maps in einem neuen Fenster)</span>
                </a>
                {%- endif %}
              </div>
              {%- if k.route_hinweis and praxis.routenlink %}
              <p class="mt-4 text-[1rem] text-paper/80">{{ k.route_hinweis }}</p>
              {%- endif %}
              {%- if gb and gb.anzeigen %}

              <a href="{{ gb.link }}" target="_blank" rel="noopener" class="group mt-8 flex max-w-[28rem] items-center gap-4 rounded-[1.25rem] bg-white/[0.07] px-5 py-4 ring-1 ring-white/12 transition-colors hover:bg-white/[0.11]">
                <span class="font-display text-[2.4rem] leading-none font-[420] text-paper">{{ gb.sterne }}<span class="sr-only"> von 5 Sternen</span></span>
                <span class="min-w-0">
                  <span class="stars !text-[#e2b77a]" aria-hidden="true"><svg><use href="#i-star"/></svg><svg><use href="#i-star"/></svg><svg><use href="#i-star"/></svg><svg><use href="#i-star"/></svg><svg><use href="#i-star"/></svg></span>
                  <span class="block text-[1rem] leading-snug text-paper/90">{{ gb.text | ohneLetztesWort }} <span class="whitespace-nowrap underline decoration-white/30 underline-offset-4 group-hover:decoration-paper">{{ gb.text | letztesWort }}</span></span>
                  {%- if gb.stand %}
                  <span class="block text-[0.875rem] text-paper/70">Stand: {{ gb.stand }}</span>
                  {%- endif %}
                </span>
                <span class="sr-only">(öffnet Google Maps in einem neuen Fenster)</span>
              </a>
              {%- endif %}
            </div>
            {%- if k.bild %}
            <figure class="relative px-3 pb-3 sm:px-4 sm:pb-4 lg:col-span-5 lg:self-center lg:py-4 lg:pr-4 lg:pl-0">
              <div class="photo aspect-[5/4] rounded-[1.25rem] lg:aspect-square lg:rounded-[1.75rem]">
                <img src="{{ k.bild }}" sizes="(min-width: 1024px) 680px, 120vw" loading="lazy" decoding="async"{% if k.bildausschnitt %} class="{{ k.bildausschnitt }}"{% endif %} alt="{{ k.bild_alt }}">
              </div>
              {%- if k.bild_hinweis %}
              <figcaption class="absolute inset-x-6 bottom-6 rounded-2xl bg-paper/95 px-4 py-3 text-[1rem] leading-snug text-ink sm:inset-x-8 sm:bottom-8 lg:inset-x-auto lg:right-8 lg:left-4">
                {% if k.bild_hinweis_titel %}<strong class="font-semibold">{{ k.bild_hinweis_titel }}</strong> {% endif %}{{ k.bild_hinweis }}
              </figcaption>
              {%- endif %}
            </figure>
            {%- endif %}
          </div>

          <dl class="grid gap-x-10 gap-y-6 border-t border-white/15 p-6 sm:grid-cols-2 sm:p-10 lg:px-14 lg:py-11 xl:grid-cols-[1fr_1fr_0.9fr_1.3fr]">
            <div>
              <dt class="label !text-brand-light">Adresse</dt>
              <dd class="mt-2 text-paper">{{ praxis.strasse }}<br>{{ praxis.plz }} {{ praxis.ort }}{% if praxis.stadtteil %}-{{ praxis.stadtteil }}{% endif %}{% if praxis.lage %}<br><span class="text-paper/80">{{ praxis.lage }}</span>{% endif %}</dd>
            </div>
            <div>
              <dt class="label !text-brand-light">Öffnungszeiten</dt>
              <dd class="mt-2 text-paper">
                {%- if zeiten.length %}
                {%- for z in zeiten %}
                <span class="grid grid-cols-[4.75rem_1fr]"><span>{{ z.tage }}</span><span{% if z.geschlossen %} class="text-paper/80"{% endif %}>{{ z.zeiten }}</span></span>
                {%- endfor %}
                {%- else %}
                {{ praxis.ohne_oeffnungszeiten }}
                {%- endif %}
              </dd>
            </div>
            <div>
              <dt class="label !text-brand-light">{{ k.termine_titel }}</dt>
              <dd class="mt-2 text-paper">{{ k.termine_text }}{% if k.termine_zusatz %}<br><span class="text-paper/80">{{ k.termine_zusatz }}</span>{% endif %}</dd>
            </div>
            <div>
              <dt class="label !text-brand-light">{% if praxis.fax %}Fax &amp; {% endif %}E-Mail</dt>
              <dd class="mt-2 text-paper">{% if praxis.fax %}{{ praxis.fax }}<br>{% endif %}<a href="mailto:{{ praxis.email }}" class="text-link-light break-words">{{ praxis.email }}</a></dd>
            </div>
          </dl>
        </div>
      </div>
    </section>
