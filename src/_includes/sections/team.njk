{#- Team on the homepage: the owners (team.yml → startseite, inhaber), a link to the team page and
    the career box (karriere.yml). Hidden when both team and career box are switched off. -#}
{%- from "partials/team-bausteine.njk" import avatar, chips -%}
{%- set t = team.startseite or {} -%}
{%- set spalten = [
  "sm:py-2 sm:pr-6",
  "sm:border-l sm:px-6 sm:py-2",
  "sm:border-l sm:py-2 sm:pl-6"
] -%}
{%- set teamLink = abschnitte.teamseite and t.link_text -%}
{%- if abschnitte.team or abschnitte.karriere %}

    <!-- ============ Team ============ -->
    <section id="{{ 'team' if abschnitte.team else 'karriere' }}" class="pb-16 sm:pb-24 lg:pb-28" aria-labelledby="{{ 'team-title' if abschnitte.team else 'karriere-title' }}">
      <div class="mx-auto max-w-[84rem] px-5 sm:px-8 lg:px-12">
        {%- if abschnitte.team %}
        <div class="grid gap-8 border-t border-line pt-12 sm:pt-16 lg:pt-20 xl:grid-cols-12 xl:gap-12">
          <div class="xl:col-span-4">
            <p class="eyebrow">{{ t.eyebrow }}</p>
            <h2 id="team-title" class="font-display mt-5 text-[2rem] leading-[1.1] font-[420] tracking-[-0.015em] sm:text-[2.5rem] lg:text-[2.7rem]">{{ t.titel }}</h2>
            {%- if t.text %}
            <p class="mt-5 max-w-[30rem]">{{ t.text | platzhalter(praxis) | safe }}</p>
            {%- endif %}
            {%- if t.zitat %}
            <p class="font-display mt-4 text-[1.45rem] leading-snug font-[400] text-ink italic">{{ t.zitat }}</p>
            {%- endif %}
            {%- if teamLink %}
            <a href="/team.html" class="link-arrow btn btn-ghost mt-8 hidden xl:inline-flex">
              {{ t.link_text }}
              <svg class="size-5 text-brand" aria-hidden="true"><use href="#i-arrow"/></svg>
            </a>
            {%- endif %}
          </div>
          <div class="min-w-0 xl:col-span-8">
            <ul class="grid border-t border-line sm:grid-cols-3 sm:border-t-0">
              {%- for person in teamInhaber %}
              <li class="flex items-center gap-5 border-b border-line py-5 sm:flex-col sm:items-start sm:gap-6 sm:border-b-0 {{ spalten[loop.index0 % 3] }}{% if loop.index0 >= 3 %} sm:mt-8{% endif %}">
                {{ avatar(person) }}
                <div>
                  <h3 class="font-display text-[1.45rem] leading-tight font-[450] sm:text-[1.6rem]">{{ person.name }}</h3>
                  {%- if person.rolle %}
                  <p class="mt-1.5 text-[1rem] leading-snug text-muted">{{ person.rolle | punkte }}</p>
                  {%- endif %}
                  {%- if person.text %}
                  <p class="mt-3 max-w-[22rem] text-[1rem] leading-snug">{{ person.text }}</p>
                  {%- endif %}
                  {{ chips(person.qualifikationen, "mt-3 ") }}
                </div>
              </li>
              {%- endfor %}
            </ul>
            {%- if teamLink %}
            <a href="/team.html" class="link-arrow btn btn-ghost mt-8 w-full text-center max-sm:whitespace-normal sm:mt-10 sm:w-auto xl:hidden">
              {{ t.link_text }}
              <svg class="size-5 text-brand" aria-hidden="true"><use href="#i-arrow"/></svg>
            </a>
            {%- endif %}
            {%- if abschnitte.karriere %}
            {%- set karriereKlassen = "mt-8 sm:mt-10 " %}

{% include "partials/karriere.njk" %}
            {%- endif %}
          </div>
        </div>
        {%- else %}
        <div class="border-t border-line pt-12 sm:pt-16 lg:pt-20">
          {%- set karriereKlassen = "" %}
{% include "partials/karriere.njk" %}
        </div>
        {%- endif %}
      </div>
    </section>
{%- endif %}
