{#- Leistungen (leistungen.yml) -#}
{%- set gruppen = leistungen.gruppen or [] -%}
{%- set indexSpalten = { "1": "grid-cols-1", "2": "grid-cols-2", "3": "grid-cols-3" } -%}
{%- if gruppen.length %}

    <!-- ============ Leistungen ============ -->
    <section id="leistungen" class="bg-stone py-16 sm:py-24 lg:py-28" aria-labelledby="leistungen-title">
      <div class="mx-auto max-w-[84rem] px-5 sm:px-8 lg:px-12">
        <div class="grid gap-6 lg:grid-cols-12 lg:items-end lg:gap-12">
          <div class="lg:col-span-7">
            <p class="eyebrow">{{ leistungen.eyebrow }}</p>
            <h2 id="leistungen-title" class="font-display mt-5 text-[2.2rem] leading-[1.08] font-[420] tracking-[-0.018em] sm:mt-6 sm:text-[2.9rem] xl:text-[3.3rem]">{{ leistungen.titel }}</h2>
          </div>
          {%- if leistungen.intro %}
          <div class="lg:col-span-5">
            <p class="max-w-[30rem]">{{ leistungen.intro | platzhalter(praxis) | safe }}</p>
          </div>
          {%- endif %}
        </div>

        <!-- Desktop: quick-jump index with the services named -->
        <nav aria-label="Leistungsbereiche" class="mt-14 hidden lg:block">
          <ul class="grid {{ indexSpalten[gruppen.length] or 'grid-cols-4' }} gap-8">
            {%- for gruppe in gruppen %}
            {%- set kennung = gruppe.titel | kennung %}
            <li><a href="#bereich-{{ kennung }}" class="group block h-full border-t-2 border-ink/80 pt-5 transition-colors hover:border-brand">
              <span class="flex items-start justify-between gap-3"><span class="font-display text-[1.3rem] leading-snug font-[450] text-ink">{{ gruppe.titel | ohneTrennung }}</span><svg class="mt-1 size-5 shrink-0 text-brand transition-transform group-hover:translate-y-0.5" aria-hidden="true"><use href="#i-arrow-down"/></svg></span>
              <span class="mt-2 block text-[1rem] leading-snug text-muted">{% if gruppe.kurzuebersicht %}{{ gruppe.kurzuebersicht | punkte }}{% else %}{% for l in gruppe.leistungen %}{{ l.name }}{% if not loop.last %}&nbsp;· {% endif %}{% endfor %}{% endif %}</span>
            </a></li>
            {%- endfor %}
          </ul>
        </nav>

        <div class="mt-10 space-y-4 sm:mt-12 lg:mt-14 lg:space-y-0">
          {%- for gruppe in gruppen %}
          {%- set kennung = gruppe.titel | kennung %}
          {%- set anzahl = (gruppe.leistungen or []).length %}

          <!-- Bereich: {{ gruppe.titel | ohneTrennung }} -->
          <article id="bereich-{{ kennung }}" class="scroll-mt-24 rounded-[1.5rem] bg-paper p-5 sm:p-7 lg:grid lg:grid-cols-12 lg:gap-12 lg:rounded-none lg:border-t lg:border-line lg:bg-transparent lg:px-0 lg:py-14" data-cat aria-labelledby="bereich-{{ kennung }}-title">
            <div class="lg:col-span-5">
              <div class="flex items-center gap-4 sm:gap-5 lg:sticky lg:top-28 lg:block">
                {%- if gruppe.bild %}
                <div class="photo size-20 shrink-0 rounded-2xl sm:size-24 lg:aspect-[16/10] lg:size-auto lg:w-full lg:rounded-[1.5rem]">
                  <img src="{{ gruppe.bild }}" sizes="(min-width: 1024px) 36vw, 150px" loading="lazy" decoding="async"{% if gruppe.bildausschnitt %} class="{{ gruppe.bildausschnitt }}"{% endif %} alt="{{ gruppe.bild_alt }}">
                </div>
                {%- endif %}
                <div{% if gruppe.bild %} class="lg:mt-7"{% endif %}>
                  <h3 id="bereich-{{ kennung }}-title" class="font-display text-[1.4rem] leading-[1.15] font-[450] tracking-[-0.01em] sm:text-[1.6rem] lg:text-[2.1rem]">{{ gruppe.titel | trennstellen | safe }}</h3>
                  <p class="mt-1 text-[1rem] font-semibold text-brand lg:mt-2">{{ anzahl }} {{ "Leistung" if anzahl == 1 else "Leistungen" }}</p>
                </div>
              </div>
            </div>
            <p class="mt-4 text-[1.0625rem] leading-snug text-body lg:hidden">{% if gruppe.uebersicht %}{{ gruppe.uebersicht }}{% else %}{% for l in gruppe.leistungen %}{{ l.name }}{% if not loop.last %}, {% endif %}{% endfor %}{% endif %}</p>
            <button type="button" class="js-only mt-4 flex min-h-[3.25rem] w-full items-center justify-between gap-4 border-t border-line pt-4 text-left font-semibold text-ink lg:hidden" aria-expanded="false" aria-controls="liste-{{ kennung }}" data-cat-toggle>
              <span data-closed>Erklärungen ansehen</span><span data-open hidden>Erklärungen schließen</span>
              <span class="acc-icon" aria-hidden="true"></span>
            </button>
            <div id="liste-{{ kennung }}" class="cat-body mt-3 lg:col-span-7 lg:mt-0">
              {%- if gruppe.text %}
              <p class="mb-3 max-w-[36rem] text-muted lg:mb-5 lg:text-[1.15rem]">{{ gruppe.text | platzhalter(praxis) | safe }}</p>
              {%- endif %}
              <div class="border-t border-line">
                {%- for l in gruppe.leistungen %}
                {%- if l.kuerzel or l.zusatz %}
                {%- set name %}<span class="flex flex-wrap items-baseline gap-x-3 gap-y-1"><span class="font-display text-[1.2rem] leading-snug font-[430] text-ink sm:text-[1.3rem]">{{ l.name }}</span>{% if l.kuerzel %}<abbr title="{{ l.kuerzel_erklaerung or l.name }}" class="text-[0.875rem] font-semibold tracking-[0.08em] text-muted no-underline">{{ l.kuerzel }}</abbr>{% endif %}{% if l.zusatz %}<span class="text-[1rem] text-muted">{{ l.zusatz }}</span>{% endif %}</span>{% endset %}
                {%- else %}
                {%- set name %}<span class="font-display text-[1.2rem] leading-snug font-[430] text-ink sm:text-[1.3rem]">{{ l.name }}</span>{% endset %}
                {%- endif %}
                {%- if l.beschreibung %}
                <details class="acc border-b border-line">
                  <summary class="flex min-h-[4.25rem] items-center justify-between gap-5 py-4">{{ name | safe }}<span class="acc-icon" aria-hidden="true"></span></summary>
                  <p class="max-w-[40rem] pr-12 pb-6">{{ l.beschreibung | platzhalter(praxis) | safe }}</p>
                </details>
                {%- else %}
                <div class="flex min-h-[4.25rem] items-center border-b border-line py-4">{{ name | safe }}</div>
                {%- endif %}
                {%- endfor %}
              </div>
            </div>
          </article>
          {%- endfor %}
        </div>
        {%- if leistungen.beratung and leistungen.beratung.text %}

        <div class="mt-6 flex flex-col gap-5 rounded-[1.5rem] bg-navy-900 p-6 text-paper sm:flex-row sm:items-center sm:justify-between sm:p-9 lg:mt-4">
          <p class="font-display max-w-[34rem] text-[1.35rem] leading-snug font-[420] sm:text-[1.55rem]">{{ leistungen.beratung.text }}</p>
          <a href="tel:{{ praxis.telefon_link }}" class="btn btn-light shrink-0">
            <svg class="size-5" aria-hidden="true"><use href="#i-phone"/></svg>
            {{ praxis.telefon | nbsp }}
          </a>
        </div>
        {%- endif %}
      </div>
    </section>
{%- endif %}
